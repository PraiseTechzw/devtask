# Expo client configuration
# Copy this file to .env for local development.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud

# Optional legacy Clerk value retained for local compatibility.
CLERK_FRONTEND_API_URL=https://replace-me.clerk.accounts.dev

# The following values are used by the Convex backend or GitHub OAuth setup.
# Store them in Convex environment variables where documented; do not expose
# client secrets or encryption keys through the Expo bundle.
GITHUB_OAUTH_CLIENT_ID=replace_me
GITHUB_OAUTH_CLIENT_SECRET=replace_me
GITHUB_OAUTH_REDIRECT_URI=devtask://github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=replace_me_with_a_long_random_secret

# Backend authentication configuration (set in Convex, not in the client bundle).
CLERK_JWT_ISSUER_DOMAIN=https://replace-me.clerk.accounts.dev
