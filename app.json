{
  "expo": {
    "name": "devtask",
    "slug": "devtask",
    "description": "A mobile-first developer project companion for focused delivery, GitHub activity, and project health.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-withbacground.png",
    "scheme": "devtask",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-withbacground.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061A45",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-withbacground.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061A45",
          "image": "./assets/images/icon.png",
          "imageWidth": 118
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#087FFF",
          "defaultChannel": "daily-nudge"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
